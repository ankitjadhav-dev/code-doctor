# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/code_doctor?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# GitHub App repository access. The private key stays in deployment secrets only.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_SLUG="code-doctor"

# Public application URL. Required in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
